# --- Podstawowe ---------------------------------------------------------------
# Publiczny adres panelu (bez ukośnika na końcu). Musi być HTTPS na serwerze,
# bo Instagram/Facebook pobierają z niego pliki, a platformy wracają tu po logowaniu.
APP_URL=https://panel.twojadomena.pl
# Hasło do logowania w panelu.
ADMIN_PASSWORD=zmien-mnie-na-dlugie-haslo
# Losowy sekret do podpisywania sesji (np. wynik: openssl rand -hex 32).
SESSION_SECRET=
# Strefa czasowa, w której wyświetlane są daty.
APP_TIMEZONE=Europe/Warsaw
# Katalog na bazę danych i wgrane pliki.
DATA_DIR=./data

# --- Facebook + Instagram (developers.facebook.com) ---------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Tylko jeśli aplikacja używa „Facebook Login for Business” (patrz README):
META_CONFIG_ID=

# --- YouTube (console.cloud.google.com) --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- TikTok (developers.tiktok.com) ------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Tylko do docker-compose (Caddy automatycznie wystawi certyfikat HTTPS) ---
DOMAIN=panel.twojadomena.pl
